// Position-grid quantum HO — ψ(x) on a truncated real line (ADR 0051/0053)
// H = ½(P² + X²) with context-typed X̂, P̂ on Position (not Pauli X).

package examples.oscillator

pub fn main() -> Unit {
    State psi = wavepacket(-6.0, 6.0, 48, 0.0, inv_sqrt2)

    Energy e = 0.5.eV to J
    Time dur = 1.0.fs
    Operator H_grid = e * (P * P + X * X)
    State psi = evolve { psi under H_grid for dur }.run()

    State viewed = inspect(psi)
    measure viewed
}
