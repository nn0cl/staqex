// Position–momentum HO — H = ½(P² + Q²) in truncated Fock (ℏ = m = ω = 1)
// Q, P are continuum quadratures represented on {|0⟩, |1⟩, …} (ADR 0049)

package examples.oscillator

pub fn main() -> Unit {
    Energy e = 0.5.eV to J
    Time dur = 1.0.fs
    Operator H_xp = e * (P * P + Q * Q)

    State psi = dirac(0)
    State psi = evolve { psi under H_xp for dur }.run()

    State viewed = inspect(psi)
    measure viewed
}
