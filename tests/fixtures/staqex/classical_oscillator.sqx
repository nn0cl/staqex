// Classical harmonic oscillator — Type-First Euler on phase space
// (Honest label: not quantum. Quantum grid HO: grid_oscillator.qpex / ADR 0051.)
// H = p²/(2m) + ½ k q² ,  (q, p) ↦ (q + (dt/m) p,  p − (dt k) q)

package examples.oscillator

import staqex.math.*

pub fn main() -> Unit {
    Delta<Time> dt = 0.5.s
    Mass m = 1.0.kg
    Stiffness k = 1.0.N_m

    State bit = coin()
    State<Length> q0 = mix (bit) {
      0 -> 1.0.m,
      else -> 1.2.m,
    }
    State<Momentum> p0 = mix (bit) {
      0 -> 0.0.kg_m_s,
      else -> 0.0.kg_m_s,
    }

    State (q, p) = evolve (q0, p0) times 2 {
      let q1 = q + (dt / m) * p
      let p1 = p - (dt * k) * q
      (q1, p1)
    }

    State viewed = inspect(q)
    measure viewed
}
