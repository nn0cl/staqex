// Classical random walk — two independent ±1 steps (product measure)
// Contrast with dtqw.qpex (coined quantum walk on H_coin ⊗ H_pos).

package examples.walk

pub fn main() -> Unit {
    State c1 = Coin()
    State c2 = Coin()
    State d1 = Mix (c1) {
      0 -> -1,
      else -> 1,
    }
    State d2 = Mix (c2) {
      0 -> -1,
      else -> 1,
    }
    State classical = d1 + d2
    State viewed = Inspect(classical)
    Measure viewed
}
