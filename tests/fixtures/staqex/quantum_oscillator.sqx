// Quantum harmonic oscillator — Fock Hamiltonian H = N + 1/2 (ℏ = ω = 1)
// U(t) = exp(-i H t) on truncated number basis {|0⟩, |1⟩, …}

package examples.oscillator

pub fn main() -> Unit {
    // Number operator + zero-point energy
    Energy e = 0.5.eV to J
    Operator H_osc = e * (N + 0.5)

    // Truncated Fock: seed |0⟩ (dim auto-extends to ≥2 under evolve)
    State psi = dirac(0)

    // Schrödinger evolve under H_osc (real time, ADR 0195)
    Time dur = 1.0.fs
    State psi = evolve { psi under H_osc for dur }.run()

    State viewed = inspect(psi)
    measure viewed
}
