// 4-site transverse-free Ising ring — sparse Pauli-sum evolve (ADR 0050)
// H = −J (Z₀Z₁ + Z₁Z₂ + Z₂Z₃ + Z₃Z₀); no dense 16×16 U materialization

package examples.statphys

pub fn main() -> Unit {
    Energy J = 1.0.eV to J
    Time dur = 1.0.fs
    Operator H4 = -J * (
        Z[0] * Z[1] + Z[1] * Z[2] + Z[2] * Z[3] + Z[3] * Z[0]
    )

    State q0 = |+>
    State q1 = |0>
    State q2 = |0>
    State q3 = |0>
    State (q0, q1, q2, q3) = Evolve { (q0, q1, q2, q3) under H4 for dur using Suzuki(order = 2, steps = 5) }.run()

    State viewed = Inspect(q0)
    Measure q0
}
