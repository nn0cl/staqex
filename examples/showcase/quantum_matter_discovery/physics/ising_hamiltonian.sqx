// Transverse-field Ising — free Operator factories (LISS-0297 struct coeffs).
// WP-0031 / LISS-0137 blackboard H(J,h); no class drive seat.

package examples.showcase.quantum_matter_discovery.physics

pub fn build_ising_hamiltonian(J: Float, h: Float) -> Operator {
    Operator H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])
    return H
}

pub fn ising_hamiltonian(p: Matter.Domain.IsingCouplings) -> Operator {
    return -p.J * (Z[0] * Z[1]) - p.h * (X[0] + X[1])
}

pub fn named_coeff_sum(p: Matter.Domain.IsingCouplings) -> Energy {
    return p.J + p.h
}
