// Domain couplings — immutable params + free scale; class only for mutable clock.
// LISS-0298: pure scores as free fns (WP-0089 surface face).

package examples.showcase.quantum_matter_discovery.domain

namespace Matter.Domain {
    pub struct IsingCouplings {
        val J: Energy
        val h: Energy
    }

    // Mutable discovery step counter (true system seat).
    pub class DiscoveryModel {
        pub val params: Matter.Domain.IsingCouplings
        var _step: Float = 0.0

        fn init(p: Matter.Domain.IsingCouplings) {
            this.params = p
        }

        pub fn mark_step() -> Float {
            this._step = this._step + 1.0
            Float done = this._step
            return done
        }
    }
}

pub fn field_scale(p: Matter.Domain.IsingCouplings) -> Energy {
    return p.J + p.h
}
