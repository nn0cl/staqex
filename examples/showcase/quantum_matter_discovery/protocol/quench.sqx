// Protocol — finite-duration quench schedule (prepare/evolve/observe intent).
// LISS-0298: struct + free scores.

package examples.showcase.quantum_matter_discovery.protocol

namespace Matter.Protocol {
    pub struct QuenchSchedule {
        val duration: Time
    }
}

pub fn schedule_duration(s: Matter.Protocol.QuenchSchedule) -> Time {
    return s.duration
}

pub fn observation_intent_tag(s: Matter.Protocol.QuenchSchedule) -> Float {
    return 1.0
}
