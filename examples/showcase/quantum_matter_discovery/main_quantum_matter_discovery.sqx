// staqex-lane: experiment
// Showcase S1 — quantum-matter discovery thin slice.
// prepare → evolve → expect → terminal measure (Never Leave the State).
// LISS-0303: ≤1 inspect peek (Host owns logs); free Operator factories.

package examples.showcase.quantum_matter_discovery

import .domain.couplings.{IsingCouplings, DiscoveryModel, field_scale}
import .physics.ising_hamiltonian.{ising_hamiltonian, named_coeff_sum}
import .protocol.quench.{QuenchSchedule, schedule_duration}

pub fn main() -> Unit {
    IsingCouplings c = IsingCouplings(1.0.eV to J, 0.5.eV to J)
    DiscoveryModel model = DiscoveryModel(c)
    Float stepped = model.mark_step()
    Energy scale = field_scale(c)
    Energy coeff_sum = named_coeff_sum(c)

    QuenchSchedule schedule = QuenchSchedule(0.7.fs)
    Time duration = schedule_duration(schedule)
    // stepped / scale / coeff_sum: classical desk (Host may log); no inspect museum.

    State bit = Coin()
    State s0 = Mix (bit) {
      0 -> |0>,
      else -> |+>,
    }

    Operator H = ising_hamiltonian(c)
    State s1 = |+>
    Operator U_t = exp(-i * H * duration / hbar)
    State (s0, s1) = Evolve() { U_t * (s0, s1) }.run()

    State zz = expect(ZZ, s0, s1)
    // Sparse notebook peek only (minimal dialect: Host owns structured logs).
    State viewed_zz = Inspect(zz)

    // Sibling leaves via partial trace (ADR 0173); not a ritual |0> rebind.
    Measure s0 tracing_out s1
}
