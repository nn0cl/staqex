// Indexed block costs — 2-wire tonight binders + 4-site satellite (LISS-0232).
// LISS-0297: free Operator factories (no class Lattice seat).

package examples.showcase.s01_disaster.grid

namespace Disaster.Grid {
    pub struct LatticeScale {
        val n_blocks: Float
    }
}

pub fn damage_hamiltonian() -> Operator {
    Operator H = Sigma (i In Index<0..1>, j In Index<0..1>) where i < j {
        Z[i] * Z[j]
    }
    return H
}

// Four-block district lattice (satellite main_lattice_four).
pub fn damage_hamiltonian_four() -> Operator {
    Operator H = Sigma (i In Index<0..3>, j In Index<0..3>) where i < j {
        Z[i] * Z[j]
    }
    return H
}

pub fn basis_zone_sum() -> Operator {
    Operator H = Sigma (i In Basis<2>) { Z[i] }
    return H
}

pub fn corridor_product() -> Operator {
    Operator P = Pi (i In Index<0..1>) { Z[i] }
    return P
}

pub fn flood_zone_sum() -> Operator {
    Operator H = Sigma (i In Index<0..1>) { X[i] }
    return H
}

pub fn lattice_tag(scale: Disaster.Grid.LatticeScale) -> Float {
    return scale.n_blocks
}
