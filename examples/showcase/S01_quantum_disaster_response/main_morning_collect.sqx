// staqex-lane: experiment
// CH-morning — Morning observation set. Locked scenario seat (SE-01).
// Arc: field morning statuses → Joint status sample; missing stays missing.
// Sparse inspect peek only (Host logs preferred).
// WP-0089 / LISS-0289: parent-relative import (ADR 0183) + selective names.

package examples.showcase.s01_disaster.morning_lane

import ..domain.ops.{CommandBoard, OpsPhase, phase_tag}
import ..domain.morning.{MorningObservation, readiness_for_day2, morning_tag}
import ..domain.shelters.{
    ShelterSite, ShelterStatus, ShelterBoard, total_remaining, shelter_pressure_tag
}
import ..domain.roads.{RoadEdge, RoadState, CorridorMap, corridor_open_score, blockage_pressure}
import ..domain.requests.{FieldRequest, RequestKind, RequestBoard, fairness_proxy, total_people}
import ..domain.hazards.{HazardCell, HazardKind, HazardBoard, secondary_pressure}
import ..domain.theatre_scale.{
    mean_cell_population, capital_cells, capital_qpu_recommended
}
import ..provenance.honesty.{HonestyDossier}
import ..physics.ops_energy_scale.{ops_energy_scale}

use OpsPhase.*
use ShelterStatus.*

pub fn main() -> Unit {
    CommandBoard board = CommandBoard(OpsPhase.MorningCollect, 1.0, 1.0)
    Float phase_pri = phase_tag(board)

    ShelterSite coastal =
        ShelterSite(
            400.0, 380.0, 800.0.kg, 289.0.K,
            ShelterStatus.NearFull, 0.5
        )
    ShelterSite inland =
        ShelterSite(
            500.0, 210.0, 1100.0.kg, 291.0.K,
            ShelterStatus.Open, 1.0
        )
    ShelterSite hill =
        ShelterSite(
            250.0, 90.0, 400.0.kg, 287.0.K,
            ShelterStatus.ClosedFlooded, 0.0
        )
    ShelterBoard shelters = ShelterBoard(coastal, inland, hill)
    Float shelter_pressure = shelter_pressure_tag(shelters)
    Float remaining = total_remaining(shelters)

    RoadEdge e01 =
        RoadEdge(
            0.0, 1.0, 1500.0.m, RoadState.Blocked, 0.0, 20.0.kg
        )
    RoadEdge e12 =
        RoadEdge(
            1.0, 2.0, 2200.0.m, RoadState.Open, 1.0, 35.0.kg
        )
    RoadEdge e23 =
        RoadEdge(
            2.0, 3.0, 1800.0.m, RoadState.Blocked, 0.0, 25.0.kg
        )
    RoadEdge e13 =
        RoadEdge(
            1.0, 3.0, 3100.0.m, RoadState.Open, 1.0, 40.0.kg
        )
    CorridorMap roads = CorridorMap(e01, e12, e23, e13)
    Float open_score = corridor_open_score(roads)
    Float block_pressure = blockage_pressure(roads)

    FieldRequest r0 =
        FieldRequest(
            RequestKind.Entrapment, 0.9, 0.0, 12.0
        )
    FieldRequest r1 =
        FieldRequest(
            RequestKind.ShelterOpen, 0.7, 1.0, 80.0
        )
    FieldRequest r2 =
        FieldRequest(
            RequestKind.MedicalSupply, 0.8, 2.0, 40.0
        )
    FieldRequest r3 =
        FieldRequest(
            RequestKind.FuelTopUp, 0.6, 3.0, 25.0
        )
    FieldRequest r4 =
        FieldRequest(
            RequestKind.AftershockSurvey, 0.95, 4.0, 6.0
        )
    RequestBoard reqs = RequestBoard(r0, r1, r2, r3, r4)
    Float fairness = fairness_proxy(reqs)
    Float people = total_people(reqs)

    HazardCell hz_after =
        HazardCell(
            HazardKind.Aftershock, 3.0, 0.6, 1.0, 0.0
        )
    HazardCell hz_fire =
        HazardCell(
            HazardKind.StructuralFire, 1.0, 0.9, 1.0, 1.0
        )
    HazardCell hz_storm =
        HazardCell(
            HazardKind.FirestormRisk, 0.0, 0.4, 0.0, 1.0
        )
    HazardBoard hazards = HazardBoard(hz_after, hz_fire, hz_storm)
    Float hazard_pressure = secondary_pressure(hazards)

    MorningObservation obs = MorningObservation(
        open_score,
        shelter_pressure,
        people + hazard_pressure,
        250.0.kg,
        0.55,
        2.0
    )
    Float day2_ready = readiness_for_day2(obs)
    Mass fuel_left = obs.fuel_remaining_kg
    Float obs_tag = morning_tag(obs)

    HonestyDossier dossier = HonestyDossier(1.0, 5.0)
    Float honesty_v = dossier.sim_lane

    Float mean_cell = mean_cell_population()
    Float capital_cells_v = capital_cells()
    Float capital_qpu = capital_qpu_recommended()

    state bit = coin()
    state status = mix (board.phase) {
      Tonight -> |0>,
      MorningCollect -> |+>,
      NextDayRecovery -> |1>,
      else -> |0>,
    }
    state shelter_gate = mix (coastal.status) {
      Open -> |+>,
      NearFull -> |0>,
      ClosedFlooded -> |1>,
      else -> |0>,
    }
    state branch = mix (bit) {
      0 -> |0>,
      else -> |+>,
    }
    // Shake: phase() on a morning observation wire (B05 surface).
    state status = phase(status, 0.2)
    Energy scale = ops_energy_scale()
    Operator H = scale * Z
    Time dur = 0.4.fs
    state status = evolve status under H for dur
    state peeked = expect(Z, status)
    // Sparse chapter peek only (SE-01: Host logs preferred; scorecard inspect seat).
    state viewed_peek = inspect(peeked)
    measure status tracing_out shelter_gate, branch
}
