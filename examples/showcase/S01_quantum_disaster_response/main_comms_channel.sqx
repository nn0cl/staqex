// staqex-lane: experiment
// CH-comms — Noisy order channel (Lindblad toy / C-box narrative). Locked seat.
// Arc: density channel noise → observed order priority bit. Full CPTP not claimed.

package examples.showcase.s01_disaster.comms_lane

pub fn main() -> Unit {
    Operator H = X
    DensityState<Qubit> rho = DensityState(
        RawMatrix([
            [1.0, 0.0],
            [0.0, 0.0]
        ])
    )
    DensityState<Qubit> observed = lindblad(
        rho,
        H,
        JumpSet([RawMatrix([
            [0.0, 1.0],
            [0.0, 0.0]
        ])]),
        0.1
    )
    // lindblad already moved the source density; terminal measure on observed.
    Measure observed
}
