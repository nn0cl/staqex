// staqex-lane: experiment
// CH-tonight-spine — E-lane Joint experiment (LISS-0246).
// Domain→Joint causal map: README §Desk causal map (LISS-0256 / LISS-0303).
// Host owns logs / TonightTicket (LISS-0243). SIM-only; not city optimum.

package examples.showcase.s01_disaster

// Desk imports — classical packs + free scores/Operator factories (selective).
import .domain.ops.{CommandBoard, OpsPhase}
import .domain.quantities.{Quantities, window_ms, water_plus_payload_g, rankine_probe_k, troy_probe_g, road_m}
import .domain.capabilities.{RescueSquad, SupplyTruck, readiness_of, haul_score}
import .domain.shelters.{ShelterSite, ShelterStatus}
import .domain.roads.{RoadEdge, RoadState, CorridorMap, blockage_pressure, corridor_open_score}
import .domain.requests.{FieldRequest, RequestKind, RequestBoard, total_people}
import .domain.comms_ops.{FairnessReport, fairness_score}
import .domain.hazards.{HazardCell, HazardKind, HazardBoard, secondary_pressure}
import .grid.block_costs.{damage_hamiltonian, corridor_product, flood_zone_sum}
import .physics.constraint_h.{ConstraintCoeffs, constraint_hamiltonian}
import .physics.ops_energy_scale.{ops_energy_scale}
import .protocol.windows.{PlanWindow}
import .protocol.compose.{compose_priority, compose_pair, compose_poly, local_priority_bump}

use OpsPhase.*
use ShelterStatus.*

pub fn main() -> Unit {
    // --- Classical ops packs (H-adjacent library; feed Joint below) ---
    CommandBoard board = CommandBoard {
        phase: OpsPhase.Tonight, phase_code: 0.0, priority: 1.0
    }

    Quantities qty = Quantities {
        road_km: 12.0.km,
        water_kg: 800.0.kg,
        window_s: 900.0.s,
        feeder_a: 40.0.A,
        shelter_k: 291.0.K
    }
    // Type-First field units (ADR 0174) via free fns (LISS-0292/0293).
    // Dimensioned — they do *not* silently become evolve Float times.
    Time window_ms_v = window_ms(qty)
    Mass water_g = water_plus_payload_g(qty)
    Temperature rankine_k = rankine_probe_k(qty)
    Mass troy_g = troy_probe_g(qty)
    Length road_m_v = road_m(qty)
    // Dimensionless Joint schedule (ops window narrative 900s / roll 15 min).
    PlanWindow win = PlanWindow { duration: 0.6, roll_minutes: 15.0 }
    Float duration = win.duration
    Float roll_min = win.roll_minutes

    ShelterSite coastal =
        ShelterSite(
            400.0, 320.0, 900.0.kg, 290.0.K,
            ShelterStatus.Open, 1.0
        )

    RoadEdge e01 =
        RoadEdge(
            0.0, 1.0, 1500.0.m, RoadState.Open, 1.0, 18.0.kg
        )
    RoadEdge e12 =
        RoadEdge(
            1.0, 2.0, 2200.0.m, RoadState.Open, 1.0, 30.0.kg
        )
    RoadEdge e23 =
        RoadEdge(
            2.0, 3.0, 1800.0.m, RoadState.Blocked, 0.0, 22.0.kg
        )
    RoadEdge e13 =
        RoadEdge(
            1.0, 3.0, 3000.0.m, RoadState.Congested, 0.5, 28.0.kg
        )
    CorridorMap corridor =
        CorridorMap(e01, e12, e23, e13)
    Float blockage = blockage_pressure(corridor)
    Float open_score = corridor_open_score(corridor)

    FieldRequest req0 = FieldRequest {
        kind: RequestKind.Entrapment, urgency: 0.95, district: 0.0, people: 8.0
    }
    FieldRequest req1 = FieldRequest {
        kind: RequestKind.ShelterOpen, urgency: 0.7, district: 2.0, people: 60.0
    }
    FieldRequest req2 = FieldRequest {
        kind: RequestKind.MedicalSupply, urgency: 0.8, district: 1.0, people: 35.0
    }
    FieldRequest req3 = FieldRequest {
        kind: RequestKind.FuelTopUp, urgency: 0.6, district: 3.0, people: 20.0
    }
    FieldRequest req4 = FieldRequest {
        kind: RequestKind.FireFighting, urgency: 0.9, district: 4.0, people: 5.0
    }
    RequestBoard requests =
        RequestBoard(req0, req1, req2, req3, req4)

    FairnessReport fair_report = FairnessReport {
        remote_weight: 1.0, loud_request_penalty: 0.15, unmet_remote: 0.35
    }
    Float fair = fairness_score(fair_report)

    HazardCell hz_after = HazardCell {
        kind: HazardKind.Aftershock,
        district: 2.0,
        intensity: 0.7,
        blocks_road_weight: 1.0,
        evacuates_weight: 0.0
    }
    HazardCell hz_fire = HazardCell {
        kind: HazardKind.StructuralFire,
        district: 0.0,
        intensity: 0.85,
        blocks_road_weight: 1.0,
        evacuates_weight: 1.0
    }
    HazardCell hz_storm = HazardCell {
        kind: HazardKind.FirestormRisk,
        district: 0.0,
        intensity: 0.55,
        blocks_road_weight: 0.0,
        evacuates_weight: 1.0
    }
    HazardBoard hazards =
        HazardBoard(hz_after, hz_fire, hz_storm)
    Float hazard_pressure = secondary_pressure(hazards)

    // Capability impl seat (readiness / haul still domain protocols).
    RescueSquad squad = RescueSquad(0.9)
    SupplyTruck truck = SupplyTruck(1.5)
    Float ready = readiness_of(squad)
    Float load = haul_score(truck)

    // Congestion from corridor blockage; fairness from audit + readiness + request load.
    Float congestion = blockage * 0.4
    Float people_total = total_people(requests)
    Float request_load = people_total * 0.002
    Float fairness_c = fair * 0.5 + ready * 0.2 + request_load
    ConstraintCoeffs coeffs = ConstraintCoeffs {
        congestion: congestion, fairness: fairness_c, _pad: 0.0
    }
    Energy scale = ops_energy_scale()
    // LISS-0407 (ADR 0206): Operator-returning calls can now be used
    // inline while scaling, no *_raw intermediates needed.
    Operator H_drive = scale * constraint_hamiltonian(coeffs)
    Operator H_damage = scale * damage_hamiltonian()
    Operator H_corridor = scale * corridor_product()
    Operator H_flood = scale * flood_zone_sum()

    // Evolve times from domain pressures + PlanWindow (not anonymous-only).
    // ADR 0195: these classical desk values stay for the causal map, but
    // cannot themselves be `to`-converted into Time (computed dimensionless
    // Float has no matching dimension) -- each evolve below is driven by an
    // independent Time literal instead (WP-0095/LISS-0348, same resolution
    // as LISS-0340/B07).
    Float t_drive = duration + load * 0.05 + request_load + roll_min * 0.001
    Float t_damage = hazard_pressure * 0.03
    Float t_flood = 0.1
    Float t_corridor = open_score * 0.04
    Time dur_drive = 0.6.fs
    Time dur_damage = 0.3.fs
    Time dur_flood = 0.1.fs
    Time dur_corridor = 0.4.fs

    // Classical⊕State fair-share ticket.
    state ration: State<Int> = 2 / 3
    state ration = ration + (1 / 4)

    // Priority pipe / Partial / poly Fusion (dispatch desk SE-05/06).
    state composed = compose_priority(3)
    state pair_sum = compose_pair(2, 5)
    state poly = compose_poly(2)
    state bumped_pri = local_priority_bump(1)

    // Enum when — phase and shelter status gate the plan wire.
    state plan0 = mix (board.phase) {
      Tonight -> |0>,
      MorningCollect -> |+>,
      NextDayRecovery -> |1>,
      else -> |0>,
    }
    state shelter_gate = mix (coastal.status) {
      Open -> |+>,
      NearFull -> |0>,
      ClosedFlooded -> |1>,
      else -> |0>,
    }
    state bit = coin()
    state plan_branch = mix (bit) {
      0 -> |0>,
      else -> |+>,
    }

    state plan1 = |+>
    state (plan0, plan1) = evolve { (plan0, plan1) under H_drive for dur_drive using Suzuki(order = 2, steps = 4) }.run()
    state (plan0, plan1) = evolve { (plan0, plan1) under H_damage for dur_damage using Suzuki(order = 2, steps = 4) }.run()
    state (plan0, plan1) = evolve { (plan0, plan1) under H_flood for dur_flood using Suzuki(order = 2, steps = 2) }.run()
    state (plan0, plan1) = evolve { (plan0, plan1) under H_corridor for dur_corridor using Suzuki(order = 2, steps = 2) }.run()

    state zz = expect(ZZ, plan0, plan1)

    // ADR 0173: leftovers leave via Born partial trace.
    measure plan0 tracing_out plan1, ration, composed, pair_sum, poly,
        bumped_pri, shelter_gate, plan_branch
}
