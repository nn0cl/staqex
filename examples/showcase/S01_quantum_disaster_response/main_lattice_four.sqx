// staqex-lane: experiment
// CH-lattice — Zone damage / flood field (Index/Basis). Locked scenario seat.
// Arc: four-zone lattice H from binders → evolve → zone sample (wider than spine).
// WP-0089 / LISS-0289: parent-relative import (ADR 0183).
// LISS-0297: free Operator factories (no class Lattice).

package examples.showcase.s01_disaster.lattice_four_lane

import ..grid.block_costs.{damage_hamiltonian_four, basis_zone_sum}
import ..physics.ops_energy_scale.{ops_energy_scale}

pub fn main() -> Unit {
    Energy scale = ops_energy_scale()
    // LISS-0407 (ADR 0206): Operator-returning calls can now be used
    // inline while scaling, no *_raw intermediates needed.
    Operator H = scale * damage_hamiltonian_four()
    Operator H_basis = scale * basis_zone_sum()
    Time dur_h = 0.15.fs
    Time dur_basis = 0.1.fs

    State a = |+>
    State b = |0>
    State c = |0>
    State d = |1>
    Operator U_h = exp(-i * H * dur_h / hbar)
    State (a, b, c, d) = Evolve() { U_h * (a, b, c, d) }.run()
    Operator U_basis = exp(-i * H_basis * dur_basis / hbar)
    State (a, b) = Evolve() { U_basis * (a, b) }.run()
    Measure a tracing_out b, c, d
}
