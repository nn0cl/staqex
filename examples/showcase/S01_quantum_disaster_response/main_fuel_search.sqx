// staqex-lane: experiment
// CH-fuel — Fuel / resource search under convergence budget. Locked seat SE-04/11.
// Arc: fuel wire evolve-until-converged max N → sample. Not the tonight spine.
// Non-placeable on static QPU IR (soft E_QPU_UNSUPPORTED_CAPABILITY).

package examples.showcase.s01_disaster.fuel_lane

pub fn main() -> Unit {
    State fuel = Dirac(0)
    Energy fuel_energy = 1.0.eV to J
    Operator H_fuel = fuel_energy * X
    Time dur = 0.1.fs
    Operator U_fuel = exp(-i * H_fuel * dur / hbar)
    State fuel = Evolve() { U_fuel * fuel until converged(fuel) max 64 }.run()
    Measure fuel
}
