// staqex-lane: experiment
// CH-route — Competing corridor phases (E-lane). Locked scenario seat.
// Arc: two corridor amplitudes with relative phase → interference → route sample.
// WP-0089 / LISS-0289: parent-relative import (ADR 0183) + named struct.

package examples.showcase.s01_disaster.phase_lane

import ..physics.interference.{RouteBoard, route_interference_tag, relative_phase_tag}

pub fn main() -> Unit {
    RouteBoard routes = RouteBoard { a: 0.6, b: 0.4 }
    Float route_tag = route_interference_tag(routes)
    Float phase_delta = relative_phase_tag(routes)

    State left = |+>
    State right = |+>
    // The board's a-b contrast is the relative phase; split it symmetrically
    // so the source shows how classical route metadata drives both amplitudes.
    State left = phase(left, phase_delta / 2.0)
    State right = phase(right, -phase_delta / 2.0)
    State corr = expect(ZZ, left, right)
    State viewed_corr = Inspect(corr)
    Measure left tracing_out right
}
