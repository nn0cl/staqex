// CH-selection-spine — S02 finite candidate-selection experiment (LISS-0405).
// Hard constraints (Projector) and soft objective (Hamiltonian evolution)
// now act on the SAME quantum coordinate: LISS-0404 (ADR 0205) shipped
// Pauli-term Hamiltonian evolution on tuple-valued coordinates, so
// psi_sel (from prepare_selection) can itself be evolved directly --
// no separate, disconnected objective qubit pair needed (superseding
// LISS-0402's original two-coordinate design).
// Host owns the candidate manifest, HostInputPort predicate matrices, and
// the classical baseline (host/run_selection.py, host/classical_baseline.py).
// SIM-only; not a chemistry, clinical, or quantum-advantage claim.

package examples.showcase.s02_drug_discovery

struct ObjectiveWeights {
    activity: Float,
    selectivity: Float,
    diversity: Float
}

// Named weighted objective terms (S02 expressiveness review P1 finding),
// acting on every one of the 8 selection positions directly (LISS-0405) --
// `sum (i in Index<0..7>) { Z[i] }` already shipped (LISS-0230/0232, S01's
// grid/block_costs.sqx). Weights are re-tuned for this larger 44-term
// acting space (ADR 0195 evolution step budget; see LISS-0405 Design
// verification).
fn objective_hamiltonian(w: ObjectiveWeights) -> Operator {
    Operator z_field = sum (i in Index<0..7>) { Z[i] }
    Operator x_field = sum (i in Index<0..7>) { X[i] }
    Operator coupling = sum (i in Index<0..7>, j in Index<0..7>) where i < j {
        Z[i] * Z[j]
    }
    return w.activity * z_field + w.selectivity * x_field + w.diversity * coupling
}

pub fn main() -> Unit {
    // --- Hard-constraint selection subspace ---
    // Fixture: 8 candidates (spec "Fixture limits" minimum), select exactly 3.
    // pairwise_compatible / diversity_at_least matrices are Host-supplied via
    // HostInputPort (ADR 0194) -- see host/run_selection.py.
    Int n = 8
    state psi_sel = prepare_selection(n)
    state psi_sel = project psi_sel onto feasible(
        exactly_selected = 3,
        pairwise_compatible = true,
        diversity_at_least = 0.3
    )

    // --- Soft-objective evolution, directly on psi_sel (LISS-0404 / ADR 0205) ---
    ObjectiveWeights weights = ObjectiveWeights {
        activity: 0.02, selectivity: 0.01, diversity: 0.01
    }
    Operator H_obj_raw = objective_hamiltonian(weights)
    Energy scale = 1.0.eV to J
    Operator H_obj = scale * H_obj_raw
    Time dur = 0.6.fs
    state psi_sel = evolve psi_sel under H_obj for dur

    // ADR 0173: no leftovers to trace out -- psi_sel is the only coordinate.
    measure psi_sel
}
