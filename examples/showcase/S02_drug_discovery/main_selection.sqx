// CH-selection-spine — S02 finite candidate-selection experiment (LISS-0406).
// Hard constraints (Projector) and soft objective (Hamiltonian evolution)
// act on the SAME quantum coordinate: LISS-0404 (ADR 0205) shipped
// Pauli-term Hamiltonian evolution on tuple-valued coordinates, so
// psi_sel (from prepare_selection) can itself be evolved directly --
// no separate, disconnected objective qubit pair (LISS-0402's original
// two-coordinate design, superseded by LISS-0405).
// Field terms carry genuine per-candidate weight (LISS-0406): activity_w/
// selectivity_w are Host-computed per-candidate arrays (ADR 0119
// coefficient tensor, wired to HostInputPort/ADR 0194 by LISS-0406) --
// the SAME values host/scoring.py's classical baseline scores against,
// not one scalar shared by every position (LISS-0405's disclosed gap).
// Host owns the candidate manifest, HostInputPort predicate/weight
// arrays, and the classical baseline (host/run_selection.py,
// host/classical_baseline.py, host/scoring.py).
// SIM-only; not a chemistry, clinical, or quantum-advantage claim.
//
// Disclosed compiler limitations found while writing this (out of scope
// here, not worked around with less-honest source shape): a `Float[N]`
// array cannot be threaded through a free-function parameter into a
// `sum` binder body ("cannot compile sparse Pauli for OpBinder"), and a
// struct-field access (e.g. `weights.activity`) cannot be used directly
// as an Operator coefficient outside a function-call return position
// ("cannot compile sparse Pauli for OpAttr") -- both are why the field
// terms and scalar multipliers below are built with plain local
// variables at `main` level instead of a separate `objective_hamiltonian`
// function taking a weights struct and array parameters.

package examples.showcase.s02_drug_discovery

pub fn main() -> Unit {
    // --- Hard-constraint selection subspace ---
    // Fixture: 8 candidates (spec "Fixture limits" minimum), select exactly 3.
    // pairwise_compatible / diversity_at_least matrices are Host-supplied via
    // HostInputPort (ADR 0194) -- see host/run_selection.py.
    Int n = 8
    state psi_sel = prepare_selection(n)
    state psi_sel = project psi_sel onto feasible(
        exactly_selected = 3,
        pairwise_compatible = true,
        diversity_at_least = 0.3
    )

    // --- Soft-objective evolution, directly on psi_sel (LISS-0404 / ADR 0205) ---
    // Per-candidate field weights (LISS-0406): `sum (i in Index<0..7>) {
    // w[i] * Z[i] }` already-shipped Index/sum/host("key") surface
    // (LISS-0230/0232, ADR 0119) -- only the Evaluator-side HostInputPort
    // wiring was missing before this Issue.
    Float[8] activity_w = host("activity_weights")
    Float[8] selectivity_w = host("selectivity_weights")
    // Re-tuned from LISS-0405's 0.02/0.01/0.01 (empirical sweep, LISS-0406
    // Design verification): the per-candidate signal in activity_w/
    // selectivity_w (range ~0.2-0.6) needs enough magnitude relative to
    // the projector/evolution structure to actually shift which feasible
    // pattern gets sampled -- confirmed by direct execution across
    // several weight/duration combinations, not guessed.
    Float w_activity = 2.0
    Float w_selectivity = 1.0
    Float w_diversity = 1.0
    Operator z_field = sum (i in Index<0..7>) { activity_w[i] * Z[i] }
    Operator x_field = sum (i in Index<0..7>) { selectivity_w[i] * X[i] }
    Operator coupling = sum (i in Index<0..7>, j in Index<0..7>) where i < j {
        Z[i] * Z[j]
    }
    Operator H_obj_raw = w_activity * z_field + w_selectivity * x_field + w_diversity * coupling
    Energy scale = 1.0.eV to J
    Operator H_obj = scale * H_obj_raw
    Time dur = 0.6.fs
    state psi_sel = evolve psi_sel under H_obj for dur

    // ADR 0173: no leftovers to trace out -- psi_sel is the only coordinate.
    measure psi_sel
}
