// staqex-lane: open
// Open-system sensor — Lindblad detector readout on the CPU lane.
// NOT a calibrated instrument model or production noise tomography stack.
// LISS-0296: selective import (ADR 0177).

package examples.applied.open_system_sensor

import .domain.sensor_config.{DetectorChannel}

pub fn main() -> Unit {
    DetectorChannel channel = DetectorChannel(0.2, 0.1)

    Operator H = X + Z

    DensityState<Qubit> rho = DensityState(
        RawMatrix([
            [1.0, 0.0],
            [0.0, 0.0]
        ])
    )

    DensityState<Qubit> observed = lindblad(
        rho,
        H,
        JumpSet([RawMatrix([
            [0.0, 1.0],
            [0.0, 0.0]
        ])]),
        channel.dwell_time
    )

    // lindblad already moved the source density; terminal measure on observed.
    Measure observed
}
