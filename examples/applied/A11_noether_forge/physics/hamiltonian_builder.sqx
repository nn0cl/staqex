// Sensor-array Hamiltonian: rotating-frame NV-center model.
//
// The real D~2.87GHz zero-field splitting (Doherty et al. 2013) defines
// the qubit basis and is transformed away (standard rotating-frame
// practice in magnetic-resonance simulation) -- only the physically
// relevant smaller terms are evolved: a transverse (X) defect/strain
// coupling on the stressed site, and real dipolar (ZZ) coupling between
// neighboring sensors. See the README "Units and interpretation".

package examples.applied.noether_forge.physics

import .domain.couplings.{SensorCouplings}

namespace Forge.Hamiltonian {
    pub fn build_sensor_hamiltonian(c: Forge.Couplings.SensorCouplings) -> Operator {
        Operator H =
            c.defect * X[1] +
            c.dip * (Z[0] * Z[1]) + c.dip * (Z[1] * Z[2])
        return H
    }
}
