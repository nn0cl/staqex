// Noether callback: a healthy (defect-free) sensor array is invariant
// under site permutation; a stress/defect site breaks that symmetry.
// The broken symmetry IS the detection signal (see observables.sqx).

package examples.applied.noether_forge.physics

namespace Forge.Symmetry {
    pub fn array_symmetry_broken(has_stressed_site: Bool) -> Bool {
        return has_stressed_site
    }
}
