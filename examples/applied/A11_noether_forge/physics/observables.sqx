// Per-site magnetization readout comparison: how far apart are the
// stressed and healthy sensors' signals? (caller supplies stressed_z
// below healthy_z, so the plain difference is already positive.)

package examples.applied.noether_forge.physics

namespace Forge.Observables {
    pub fn signal_gap(healthy_z: Float, stressed_z: Float) -> Float {
        return healthy_z - stressed_z
    }
}
