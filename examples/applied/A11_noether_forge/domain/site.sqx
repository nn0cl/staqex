// Sensor site identity and structural-health role.

package examples.applied.noether_forge.domain

namespace Forge.Site {
    pub enum SensorRole {
        Healthy,
        Stressed
    }

    pub struct SiteId {
        val index: Int
    }

    pub struct SensorSite {
        val id: SiteId
        val role: SensorRole
    }

    pub fn is_stressed(site: SensorSite) -> Bool {
        return site.role == SensorRole.Stressed
    }
}
