// staqex-lane: experiment
// Robot graph planner — DTQW exploration + Grover corridor oracle (toy).
// NOT real-time robot control or production motion planning.
// LISS-0296: selective import (ADR 0177).

package examples.applied.robot_graph_planner

import .domain.robot_graph.{ConfigGraph}
import .operators.graph_walk.{build_graph_coin, step_graph_hop}
import .operators.goal_oracle.{collision_free_corridor}

pub fn main() -> Unit {
    ConfigGraph graph = ConfigGraph(8, 5, 12)
    Operator walk_operator = build_graph_coin()

    State<Qubit> c = |+>
    State<Position> x = Dirac(0)
    State<(Qubit, Position)> (c, x) = c *|* x

    // Unrolled DTQW hops (coin then conditional shift).
    State c = apply(walk_operator, c)
    State x = walk_shift(c, x)
    State c = apply(walk_operator, c)
    State x = walk_shift(c, x)

    // Module `evolve` + imported step surface (identity step; see operators).
    State (c, x) = Evolve (c, x) times graph.walk_steps {
        step_graph_hop(walk_operator, c, x)
    }

    State mx = expect(X, c)
    State viewed_mx = Inspect(mx)

    // Classical oracle harvest (Float); phase mark uses a literal target index.
    Float corridor = collision_free_corridor()
    Float target = 2.0

    State b0 = Coin()
    State b1 = Coin()
    State route = b0 * 2 + b1
    State marked = phase(route, pi, target)
    State amplified = grover_diffuse(marked)
    State viewed = Inspect(amplified)

    // Grover chain / walk moved some roots; remaining live leftovers via partial trace.
    Measure viewed tracing_out b0, b1, x
}
