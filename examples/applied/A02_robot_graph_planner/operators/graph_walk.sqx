// DTQW step on a configuration graph — Coin ≈ R_y(π/2), then walk_shift.

package examples.applied.robot_graph_planner.operators

pub fn build_graph_coin() -> Operator {
    Operator CoinOp = (X + Z) * inv_sqrt2
    return CoinOp
}

// Identity joint step: intermediate `apply`/`walk_shift` binds before
// `return c *|* x` currently trip LINEAR_IMPLICIT_DISCARD (consume-on-return
// gap; same as B09). Real coin+shift is unrolled in main until that language
// follow-up.
pub fn step_graph_hop(operator: Operator, c: State<Qubit>, x: State<Position>) -> State<(Qubit, Position)> {
    return c *|* x
}
