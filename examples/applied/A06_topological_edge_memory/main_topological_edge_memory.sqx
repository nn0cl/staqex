// staqex-lane: experiment
// SSH edge-state evolution — multi-file structure + hop Schrödinger evolve.
// Left-edge |0⟩ under topological SSH (w>v, open BC); occupation(·) is non-destructive.
// WP-0089 / LISS-0289: relative import (0183) + named leaf structs (0181).
// LISS-0296: full selective import + free pure scores (band_gap / topological_index).
// Multi-file keeps package (not experiment-profile single-file).

package examples.applied.topological_edge_memory

import .domain.topology.{BoundaryCondition, ChainLattice}
import .domain.ssh_parameters.{SSHParams, SSHSystem, band_gap, topological_index}
import .operators.hamiltonian_builder.{build_ssh_hamiltonian}

pub fn main() -> Unit {
    BoundaryCondition bc = BoundaryCondition.Open
    ChainLattice lat = ChainLattice { num_cells: 3, bc: BoundaryCondition.Open }

    SSHParams p = SSHParams { v_intra: 0.5, w_inter: 1.5 }
    SSHSystem sys = SSHSystem(p, BoundaryCondition.Open)
    Float stepped = sys.step()
    Float winding = topological_index()
    Float gap = band_gap(p)

    Operator Hssh = build_ssh_hamiltonian()
    State<Position> psi = Dirac(0)
    Time dur = 0.5.fs

    State psi = Evolve { psi under Hssh for dur }.run()

    // Notebook quantities (Host may log); not inspect floods before measure.
    Float left = occupation(psi, 0)
    Float right = occupation(psi, 5)

    Measure psi
}
