// staqex-lane: circuit
// Attention-inspired variational feature map — 2–4 qubit QML toy.
// NOT GPT-scale LLM inference, transformer training, or billion-parameter models.

package examples.applied.quantum_attention_toy

pub fn main() -> Unit {
    QubitRegister<3> wires = system()
    ForEach q in wires {
        apply(H, q)
    }

    State query = |+>
    State key = |0>
    State value = |0>

    State key = capply(query, X, key)
    State value = capply(query, Z, value)
    State key = phase(key, pi / 2.0)

    State open_ctrl = |0>
    State open_tgt = |0>
    State open_tgt = ocapply(open_ctrl, X, open_tgt)

    State a = |1>
    State b = |0>
    State mixed_tgt = |0>
    State mixed_tgt = capply(a, !b, X, mixed_tgt)

    State c0 = |1>
    State c1 = |1>
    State ccx_tgt = |0>
    State ccx_tgt = toffoli(c0, c1, ccx_tgt)

    State score = expect(ZZ, query, key)
    State viewed_score = Inspect(score)

    // Controls already moved by capply/toffoli; live targets leave via partial trace.
    Measure value tracing_out key, open_tgt, mixed_tgt, ccx_tgt
}
