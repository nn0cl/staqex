// Observatory control capsule — immutable public configuration plus a private clock.

package examples.applied.mission_observatory.domain

namespace Observatory {
    pub enum MissionPhase {
        Survey,
        Interference,
        Link
    }

    pub struct Config {
        val steps: Int
        val duration: Time
        val station: Int
    }

    pub class Run {
        var _tick: Float = 0.0
        pub val config: Observatory.Config

        fn init(c: Observatory.Config) {
            this.config = c
        }

        pub fn advance() -> Float {
            this._tick = this._tick + 0.1
            return this._tick
        }
    }
}
