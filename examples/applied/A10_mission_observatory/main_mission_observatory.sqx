// staqex-lane: circuit
// Mission observatory — slim integration capstone (modules + CPU/QPU lanes).
// Canonical deep dives live in B01–B12 and A06–A09; this is a read path only.
// LISS-0296: selective import (ADR 0177).

package examples.applied.mission_observatory

import .domain.observatory_config.{Config, Run}
import .domain.topology.{Chain, BoundaryCondition}
import .domain.link_parties.{OpticalHop}
import .operators.ssh_hamiltonian.{build_ssh_hamiltonian}
import .operators.bell_channel.{build_link_witness}

pub fn main() -> Unit {
    Config config = Config(3, 0.25.fs, 0)
    Run mission = Run(config)
    Float tick = mission.advance()

    Chain chain = Chain(2, BoundaryCondition.Open)
    OpticalHop hop = OpticalHop(0, 1)
    // hop.source is classical metadata; no unused inspect bind.

    state site = dirac(0)
    Operator Hssh = build_ssh_hamiltonian()
    // ADR 0174 struct-field units aren't recognized by evolve's
    // fail-closed check directly (LISS-0335) -- bind to a local first.
    Time dur = config.duration
    state site = evolve { site under Hssh for dur }.run()

    QubitRegister<3> register = system()
    forEach q in register {
        apply(H, q)
    }

    state observatory = |+>
    state probe = |0>
    state probe = cnot(observatory, probe)
    state correlation = expect(ZZ, observatory, probe)
    state viewed_corr = inspect(correlation)
    Float ideal = build_link_witness()
    state viewed_ideal = inspect(ideal)

    // SSH site still live; cnot already moved observatory (ADR 0173).
    measure probe tracing_out site
}
