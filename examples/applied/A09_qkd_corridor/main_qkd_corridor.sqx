// staqex-lane: experiment
// QKD corridor — Bell / EPR link Earth station ↔ craft.
// Dream: untappable command link. NOT a real BB84/E91 stack or Mars modem.
// LISS-0296: selective import (ADR 0177).

package examples.applied.qkd_corridor

import .domain.link_parties.{OpticalHop}
import .operators.bell_channel.{ideal_zz_correlation}

pub fn main() -> Unit {
    OpticalHop hop = OpticalHop(0, 1)

    Float ideal_zz = ideal_zz_correlation()

    State alice = |+>
    State bob = |0>
    State bob = cnot(alice, bob)

    State corr = expect(ZZ, alice, bob)
    State viewed_corr = inspect(corr)
    State viewed_ideal = inspect(ideal_zz)
    // hop.alice_station is classical metadata (party index); no inspect bind.

    // Do not inspect `bob` before terminal measure; cnot already moved Alice.
    measure bob
}
