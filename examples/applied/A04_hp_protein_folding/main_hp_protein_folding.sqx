// staqex-lane: experiment
// HP lattice ground-state search — Grover over toy conformations.
// NOT real protein folding, force fields, or structural biology pipelines.
// LISS-0296: selective import (ADR 0177).

package examples.applied.hp_protein_folding

import .domain.lattice_model.{LatticeToy}
import .operators.hp_oracle.{ground_conformation_index}

pub fn main() -> Unit {
    LatticeToy lattice = LatticeToy(4, 1)
    // Classical oracle harvest; phase mark uses a literal ground index
    // (namespace Float return is not yet a reliable runtime bind for `phase`).
    Float harvested = ground_conformation_index()
    Float ground = 1.0

    State b0 = coin()
    State b1 = coin()
    State conf = b0 * 2 + b1

    State marked = phase(conf, pi, ground)
    State amplified = grover_diffuse(marked)
    State viewed = inspect(amplified)

    // phase/diffuse moved conf/marked; live index bits leave via partial trace.
    measure viewed tracing_out b0, b1
}
