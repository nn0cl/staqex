// B07 — namespace / enum / struct / visibility (ADR 0058).
// Geometry packs are struct/enum; Hamiltonian from free-fn + param struct
// (LISS-0297 / LISS-0300). `_pad` is the module-private visibility seat.
// Mutable physical systems with clocks stay `class` elsewhere (A06, QMD, A10).
// WP-0089 / LISS-0289: named struct construction (ADR 0181).

namespace Geometry {
    pub enum Boundary {
        Open,
        Periodic
    }

    pub struct Segment {
        val length: Float
        val bc: Boundary
    }
}

namespace Model {
    // Couplings pack — `_pad` is intentionally not `pub` (visibility demo).
    pub struct IsingParams {
        pub val J: Energy
        pub val h: Energy
        val _pad: Float
    }
}

pub fn ising_hamiltonian(p: Model.IsingParams) -> Operator {
    return -p.J * (Z[0] * Z[1]) - p.h * (X[0] + X[1])
}

Geometry.Segment seg = Geometry.Segment { length: 2.0, bc: Geometry.Boundary.Open }
Float scale = seg.length

// ADR 0195: real Energy coefficients (ratio preserved from the original
// 1.0 / 0.5); the evolve duration below is an independent real Time
// value -- a struct-field-derived expression (like the old `scale *
// 0.25`) can no longer directly become one (unit suffixes only attach
// to literals), so `scale` stays a standalone struct-field-read demo.
Model.IsingParams params = Model.IsingParams { J: 1.0.eV to J, h: 0.5.eV to J, _pad: 0.0 }
Operator H = ising_hamiltonian(params)

Time dur = 0.5.fs

State s0 = |+>
State s1 = |+>
Operator U_t = exp(-i * H * dur / hbar)
State (s0, s1) = Evolve() { U_t * (s0, s1) }.run()
Measure s0 tracing_out s1
