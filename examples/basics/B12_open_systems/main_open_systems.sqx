// B12 — one-qubit Lindblad detector model on the CPU lane.
// staqex-lane: open

Operator H = X

DensityState<Qubit> rho = DensityState(
    RawMatrix([
        [1.0, 0.0],
        [0.0, 0.0]
    ])
)

DensityState<Qubit> observed = lindblad(
    rho,
    H,
    JumpSet([RawMatrix([
        [0.0, 1.0],
        [0.0, 0.0]
    ])]),
    0.1
)

// lindblad already moved the source density; terminal measure on observed.
Measure observed
