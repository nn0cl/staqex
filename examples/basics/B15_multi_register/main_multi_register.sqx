// staqex-lane: circuit
// B15 — named registers and RegisterSet acting space (LISS-0067 / ADR 0105).

system Link {
    register data : QubitRegister<1>
    register ancilla : QubitRegister<1>
}

Operator<RegisterSet<Link>> zz = Z[data[0]] * Z[ancilla[0]]

State data = |0>
State ancilla = |0>
State corr = expect(ZZ, data, ancilla)
State viewed = inspect(corr)

// Ancilla leaves via partial trace; terminal measure on data.
measure data tracing_out ancilla
