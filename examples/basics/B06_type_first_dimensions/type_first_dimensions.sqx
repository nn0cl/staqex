// B06 — Type-First quantities carry (L,M,T) dimensions.

import staqex.math.*

// Dimension tags live on State payloads. Classical Type-First heads
// (`Delta<Time> dt = 0.5.s`) mixed into State arithmetic are a language
// follow-up — see LISS-0122 notes.
State<Time> dt = dirac(0.5.s)
State<Mass> m = dirac(1.0.kg)
State<Stiffness> k = dirac(1.0.N_m)

State bit = coin()

State<Length> x = mix (bit) {
  0 -> 0.0.m,
  else -> 1.0.m,
}
State<Momentum> p = mix (bit) {
  0 -> 1.0.kg_m_s,
  else -> 0.0.kg_m_s,
}

State (x, p) = evolve (x, p) times 2 {
  (x + (dt / m) * p, p - (dt * k) * x)
}

State viewed = inspect(x)
// Type-First State leftovers leave via partial trace (ADR 0173 / LISS-0311).
// Not ritual vacuum rebinds — dt/m/k/p remain dimensioned linear carriers.
measure viewed tracing_out dt, m, k, p
