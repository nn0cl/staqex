// B04 — repetition uses `evolve times N` / evolve-under, not classical loops (axiom 4).

// ADR 0195 / LISS-0339: the legacy bare-Pauli-letter evolve form is not
// hbar-divided (its duration is a rotation angle, not physical time) --
// declared in seconds only to satisfy the Kernel's real-Time-unit check.
Time dur = 1.5707963267948966.s

State psi = |+>
State psi = evolve { psi under Z for dur }.run()
State ez = expect(Z, psi)
State viewed = inspect(ez)

measure psi
