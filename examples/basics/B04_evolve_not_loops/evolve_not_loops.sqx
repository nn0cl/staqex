// B04 — repetition uses `evolve times N` / evolve-under, not classical loops (axiom 4).

// The finite evolution is written as an explicit propagator so the source
// retains the blackboard distinction between H and U(t).
Time dur = 1.5707963267948966.fs
Energy scale = 1.0.eV to J

State psi = |+>
Operator H = scale * Z
Operator U_dur = exp(-i * H * dur / hbar)
State psi = Evolve() { U_dur * psi }.run()
State ez = expect(Z, psi)
State viewed = Inspect(ez)

Measure psi
