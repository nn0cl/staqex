// Walk operators — exported Operator factory + one DTQW step.

package examples.basics.multi_file_modules.operators

pub fn build_coin_operator() -> Operator {
    Operator CoinOp = (X + Z) * inv_sqrt2
    return CoinOp
}

pub fn step_quantum_walk(operator: Operator, c: State<Qubit>, x: State<Position>) -> State<(Qubit, Position)> {
    State c2 = apply(operator, c)
    State x2 = walk_shift(c2, x)
    return c2 *|* x2
}
