// staqex-lane: experiment
// B09 — multi-file DTQW via module import (ADR 0054).
// WP-0089 / LISS-0289: package-relative import (ADR 0183); package+main retained.
// LISS-0299: selective braces (WalkEnvironment harvest of n_steps still works).

package examples.basics.multi_file_modules

import .domain.walk_environment.{WalkEnvironment}
import .operators.walk_operators.{build_coin_operator, step_quantum_walk}

pub fn main() -> Unit {
    Operator walk_operator = build_coin_operator()

    State c = |0>
    State x = dirac(0)
    State (c, x) = c *|* x

    // Unrolled DTQW steps (coin then conditional shift).
    State c = apply(walk_operator, c)
    State x = walk_shift(c, x)
    State c = apply(walk_operator, c)
    State x = walk_shift(c, x)

    // Module `evolve` + imported step surface (identity step; see operators).
    State (c, x) = evolve (c, x) times n_steps {
        step_quantum_walk(walk_operator, c, x)
    }

    State viewed = inspect(x)
    // Walk/evolve already moved the coin wire; measure the position peek.
    measure viewed
}
