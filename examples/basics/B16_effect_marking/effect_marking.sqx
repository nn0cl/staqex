// B16 — explicit effect marking (ADR 0081).
// Pure `fn` by default; Inspect is declared and propagates (not collapse).
// LISS-0306 / re-review P1-5: effects are visible pedagogy, not a new vocabulary.

// Non-collapsing notebook peek — must declare Inspect (pure callers cannot hide it).
fn peek_zz(z: State<Float>) -> State<Float> effects { Inspect } {
    return inspect(z)
}

// ADR 0195: J/h carry real Energy units; H stays inferred.
Energy J = 1.0.eV to J
Energy h = 0.5.eV to J
H = -J * (Z[0] * Z[1]) - h * (X[0] + X[1])

State s0 = |+>
State s1 = |+>
Time dur = 0.5.fs
State (s0, s1) = evolve { (s0, s1) under H for dur using Suzuki(order = 2, steps = 4) }.run()

State zz = expect(ZZ, s0, s1)
// ≤1 peek via an effect-marked helper (Host still owns structured logs).
State viewed = peek_zz(zz)

// Peek is non-collapsing; leave it when measuring the evolve wire.
measure s0 tracing_out s1, viewed
